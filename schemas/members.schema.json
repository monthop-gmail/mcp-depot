{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/monthop-gmail/mcp-depot/schemas/members.schema.json",
  "title": "mcp-depot deployment membership (L3, site only, never in git)",
  "description": "Mounted read-only into one deployment. See docs/decisions/0002-permissions-default-deny.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["members"],
  "properties": {
    "members": {
      "type": "object",
      "propertyNames": { "pattern": "^(user:[^@\\s]+@[^@\\s]+|service:\\S+)$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roles"],
        "properties": {
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
          },
          "scopes": {
            "type": "object",
            "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1, "maxLength": 200 }
            }
          }
        }
      }
    }
  }
}
